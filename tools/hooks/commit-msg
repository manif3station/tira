#!/usr/bin/env bash
#
# A commit must name the card it belongs to, and that card must be somewhere
# that means "being worked on".
#
# The push gate catches a board that has drifted, but it catches it hours after
# the drift began. A commit is the frequent, unavoidable moment - so this is
# where the board is forced to be current. If the work is real enough to
# commit, the card is real enough to have been moved.
#
# Michael's ask on 2026-08-11, in his words: close the loophole without him
# having to keep checking on the agent who is supposed to be managing the
# board. This is that, at the point where drift actually starts.

set -euo pipefail

message_file="$1"
root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"

fail() { printf '\n\033[31mcommit-msg: %s\033[0m\n' "$1" >&2; exit 1; }

message="$(cat "$message_file")"

# Merges, reverts and fixups are generated by git itself and carry no card.
case "$message" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

refs="$(grep -oE '\b(SOW|EPC|TKT)-[0-9]{3,}\b' <<<"$message" | sort -u || true)"
[ -n "$refs" ] || fail 'name the card this commit belongs to, e.g. TKT-013.
A commit with no card is work the board cannot account for.'

command -v d2 >/dev/null || fail 'd2 is not on PATH, so the card cannot be checked - refusing rather than skipping'

# Columns that mean the work is not being done right now. A commit against one
# of these is the exact drift this hook exists to stop: code moving while the
# board says nothing is happening.
idle='backlog|discard|done'

for ref in $refs; do
  case "$ref" in
    SOW-*) kind=sow ;;
    EPC-*) kind=epic ;;
    *)     kind=ticket ;;
  esac

  # Read the card back through Tira rather than trusting the message. The
  # commit message is the claim; this is the independent check of it.
  card="$(d2 "tira.$kind.show" --ref "$ref" -o json 2>/dev/null || true)"
  [ -n "$card" ] || fail "$ref is not on the board"
  grep -q '"error"' <<<"$card" && fail "$ref is not on the board"

  column="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("column",""))' <<<"$card")"
  if grep -qE "^($idle)$" <<<"$column"; then
    fail "$ref is in '$column'.
Move it to the gate the work is actually at before committing against it:
  d2 tira.$kind.move --ref $ref --column implement"
  fi
done

exit 0

#!/usr/bin/env bash
#
# The release gate, as a gate rather than as a habit.
#
# Push is part of "done" in this workspace, so this is the last moment anything
# can be caught. Everything here was previously "something I always do", and on
# 2026-08-11 the owner found, in one morning: a card with no fields moving
# between columns, a card whose checklist was finished while its column said
# otherwise, tickets that were all orphans because an argument was silently
# ignored, and a board destroyed with no backup to restore from. None of those
# were caught by a habit. They are caught here.
#
# Every check fails closed. A missing tool is a failure, not a skip - a gate
# that disappears when you delete a file is not a gate.

set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$root"
workspace="$(cd "$root/../.." && pwd)"

step() { printf '\n\033[1mpre-push: %s\033[0m\n' "$1"; }
fail() { printf '\n\033[31mpre-push: %s\033[0m\n' "$1" >&2; exit 1; }

# --- a release nobody would receive -------------------------------------
#
# Developer Dashboard installs a skill by comparing versions: same version, no
# update. Tira's own self-restart compares the installed version with the
# running one and does the same. So a push that changes shipped code without
# changing VERSION is in the repository and on nobody's machine.
#
# That trap cost hours in one night: the board was being driven by an installed
# copy at 1.04 while the working tree was well past it, so commands that existed
# answered "not found" and features that were built had never arrived.
step 'checking the version against what is being shipped'

# What is being pushed, found without asking for an upstream branch: this
# repository has no tracking branch configured, so the first version of this
# check asked for one, found none, and quietly did nothing - a gate that
# disappears, which is the exact failure everything else here is written to
# avoid. The remote ref is what git actually has; where there is none, every
# file counts as changed and the check still runs.
branch="$(git rev-parse --abbrev-ref HEAD)"
base="$(git rev-parse --verify --quiet "origin/$branch" || true)"
[ -n "$base" ] || base="$(git hash-object -t tree /dev/null)"

changed="$(git diff --name-only "$base"..HEAD -- lib cli skills collector dashboard.psgi cpanfile || true)"
if [ -n "$changed" ]; then
    version_changed="$(git diff --name-only "$base"..HEAD -- .env || true)"
    [ -n "$version_changed" ] || fail "shipped files changed and VERSION did not:
$(printf '%s' "$changed" | head -5)
An install compares versions, so this release would reach nobody. Bump VERSION
in .env, and lib/Tira.pm and t/03-metadata.t with it."
fi

# --- the board is backed up before anything else ------------------------
#
# The board is deliberately outside git, so a push is the natural moment to
# take a copy. It costs a second and it is the difference between losing
# minutes and losing the morning.
step 'backing up the board'
[ -x tools/board-backup ] || fail 'tools/board-backup is missing - refusing to push without a backup'
tools/board-backup >/dev/null || fail 'the board backup failed'

# --- every live card is real work ---------------------------------------
step 'checking the board for incomplete or stalled cards'
[ -x tools/card-holes ] || fail 'tools/card-holes is missing - refusing to push without the card check'
tools/card-holes || fail 'fill the cards in, or discard what is not real work'

# --- the suite and the coverage gate ------------------------------------
#
# Run last and run here, because documentation edits made after a manual gate
# run have shipped a broken build before. Nothing can be edited between this
# passing and the push happening.
step 'running the full suite with coverage (this takes a few minutes)'
compose="$workspace/docker-compose.testing.yml"
[ -f "$compose" ] || fail "cannot find $compose - refusing to push untested"

output="$(mktemp)"
trap 'rm -f "$output"' EXIT
# Under a timeout, because a suite can stop without failing. A test that leaks
# a web server leaves prove waiting on a pipe nothing will ever close: no
# output, no CPU, no end. Eighteen minutes of that looked exactly like a slow
# run, twice, before anybody looked inside the container. A gate that can block
# for ever is one that gets skipped, so it fails instead.
docker compose -f "$compose" run --rm perl-test bash -lc '
  cd /workspace/skills/tira &&
  rm -rf cover_db .test-tmp &&
  cpanm --quiet --notest --installdeps . >/dev/null 2>&1 &&
  timeout --signal=KILL 900 env HARNESS_PERL_SWITCHES=-MDevel::Cover prove -lr t 2>&1 | tail -4 &&
  cover -ignore_covered_err -report text \
    -select lib/Tira.pm -select lib/Tira/CLI.pm -select lib/Tira/DashboardWeb.pm \
    -coverage statement -coverage subroutine 2>/dev/null | grep -E "^lib|^Total"
  rm -rf cover_db
' >"$output" 2>&1 || fail "the suite did not run: $(tail -3 "$output")"

grep -q '^Result: PASS' "$output" || fail "the suite failed:
$(grep -E 'Failed|Result:' "$output" | head -10)"

# A module that is not listed has not been measured, which must not read as a
# pass. Each of the three has to appear AND be at 100.
for module in 'lib/Tira.pm' 'lib/Tira/CLI.pm' 'lib/Tira/DashboardWeb.pm'; do
  line="$(grep -F "$module" "$output" | grep -E '[0-9]+\.[0-9]' || true)"
  [ -n "$line" ] || fail "no coverage was measured for $module"
  echo "$line" | grep -qE '100\.0[[:space:]]+100\.0[[:space:]]+100\.0' \
    || fail "coverage is below 100% for $module: $line"
done

# --- the documentation describes what actually ships ---------------------
#
# Last, deliberately. Documentation edited after a gate has shipped a broken
# build here twice, so anything that runs before the edits proves nothing about
# what goes out. This is the final thing that can stop a release.
step 'checking the documentation against the code'
[ -x tools/docs-match-code ] || fail 'tools/docs-match-code is missing - refusing to push undocumented'
tools/docs-match-code || fail 'the documentation and the code disagree'

# And every example run rather than read. His words. The policies document
# shipped with an example the validator refuses, and nothing but executing it
# would have found that.
step 'running every documented example'
[ -x tools/docs-examples-run ] || fail 'tools/docs-examples-run is missing - refusing to push examples nobody ran'
tools/docs-examples-run || fail 'a documented example is not what the command accepts'

# And the browser opened, rather than seven files being counted as though it
# had been. They sat in t/playwright for months: prove reads .t and these are
# .js, so the suite never saw them, and nothing else ran them either. A check
# nobody runs is worse than no check, because it is counted - and running them
# turned up three stale contracts and two dead controls on the page a person
# looks at.
#
# Fails closed. If node or playwright is missing this refuses rather than
# skipping, because skipping quietly is exactly how they came to be ignored.
step 'opening a browser on the board'
[ -x tools/browser-tests ] || fail 'tools/browser-tests is missing - refusing to push with the browser unopened'
tools/browser-tests || fail 'a browser test failed, or could not be run at all'

step 'suite passed, coverage is 100% on all three modules, documentation agrees, board backed up'

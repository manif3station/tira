#!/usr/bin/env python3
"""Run every example in the documentation, rather than reading it.

Exit 0 when every documented example is understood by the command it names,
1 when any is not.

Michael's requirement, in his words: every documented example has to be run
rather than read. The policies document shipped with an example the validator
refuses, and nothing but executing it would have found that.

What counts as a failure is narrow on purpose. An example naming TKT-001 on a
scratch board fails because that card is not there, and that says nothing about
the documentation. What it must never do is fail because the command does not
exist, because an option is not accepted, or because a value is refused - those
are the documentation describing something Tira will not do.

Usage: tools/docs-examples-run
"""

import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile

DOCUMENTS = ('SKILLS.md', 'docs/commands.md', 'docs/POLICIES.md')

# An example is a backticked command line beginning with the dispatcher, or a
# command line at the start of a line in a fenced block. The dispatcher is
# written three ways across these documents - `dashboard tira.x` in the
# manual's prose, a bare `tira.x` in older fenced blocks, and `d2 tira.x`
# throughout the policies guide - and only the first two were ever collected.
#
# That was found by breaking a policies example on purpose and watching the
# check report everything understood: all 132 of the guide's examples matched
# neither pattern, so the document with by far the most worked examples in it
# was listed here and contributed nothing. The docstring above still said the
# guide was written the second way, which had been true when this was written.
# The guide's style moved and the checker did not.
BACKTICKED = re.compile(r'`(dashboard tira\.[^`]+)`')
# Any indent, and a trailing comment counts as part of the example.
#
# It allowed at most two leading spaces while both documents indent their worked
# examples by four, and it required the next token to begin with a dash while
# the documents annotate examples - "d2 tira.doctor    # what is damaged, and
# where". Nineteen distinct examples matched neither pattern and were collected
# by nothing: not run, not set aside, in neither number, and so invisible in the
# summary the push gate reads.
#
# The trailing comment is the sharper half. The runner has always handled one -
# shlex.split(line, comments=True), because "a trailing '# set it' is a note to
# the reader rather than an argument" - so the code that RUNS an example
# believed examples carry comments while the code that FINDS them could not
# match a single one.
#
# Deliberately not widened to any trailing text. A sentence of prose beginning
# with a command name would then be collected and run.
FENCED = re.compile(r'^\s*(?:d2\s+|dashboard\s+)?(tira\.[a-z][a-z0-9._-]*(?:\s+--?[^\n]*|\s*#[^\n]*)?)$', re.M)

# A line ending in a backslash is half a command. Running the half would fail
# for a reason that says nothing about the documentation, so it is set aside
# like any other line that cannot be run as it stands - and counted, which is
# the whole point of this change.
CONTINUED = re.compile(r'\\\s*$')

# Anything in quotes is a value somebody typed, whatever it looks like. "MT5"
# is a project name, not a shape - and treating it as one skipped the example
# silently, which is how a deliberately broken example passed this check.
QUOTED = re.compile(r'"[^"]*"|\'[^\']*\'')

# A reference is a real value, not a placeholder: TKT-001 is something to type.
REFERENCE = re.compile(r'\b[A-Z][A-Z0-9-]*-\d+\b')

# Everything else in capitals, or in angle or square brackets, is a shape a
# reader is meant to replace. Listing them by name missed SHA256 and EXT and
# reported three examples as broken that were perfectly correct - so the rule
# is the shape rather than a list somebody has to keep up to date.
PLACEHOLDER = re.compile(r'<[^>]+>|\[[^\]]+\]|\b[A-Z][A-Z0-9_]{1,}\b|\.\.\.')

# Commands that are meant never to return: police watches until it is stopped,
# the bridge tails, a browser dashboard serves, and onboarding waits for
# somebody to type. Running one of those here would hang the check for ever,
# which is what happened the first time this was run. They are named rather
# than detected by timeout, because a timeout would also hide a real hang.
FOREVER = ('tira.police', 'tira.policy.bridge', 'tira.onboard')

# The failures that mean the documentation is wrong, rather than the scratch
# board being empty.
FATAL = (
    'Unsupported Tira command',
    'Unknown option',
    'Invalid command-line options',
    'not found in skill',
    'Usage:',
)

# Commands whose whole job is to print a document, judged by whether they
# succeeded rather than by what the document says.
#
# The check above looks for error text anywhere in the output, which is right
# for a command that answers and wrong for one that recites. The 1.77 changelog
# describes a bug whose symptom was "Command project.show not found in skill
# tira" - so printing the changelog contained that sentence, and a release was
# refused on the grounds that a shipped command does not exist.
#
# That is the fault this project keeps meeting from a new direction: a release
# refused for a reason that is not about the release. A guide that documents an
# error message will always contain that error message, and a check that cannot
# tell a quotation from an occurrence would forbid writing about failure at all.
RECITERS = ('tira.changes', 'tira.skills', 'tira.usage', 'tira.policies')



def collect(document):
    """Every line in a document that looks like an example, counted independently.

    Deliberately not the same code as examples(): the point is to notice when
    that code misses something, and a check that shares the thing it checks
    notices nothing. This one is as blunt as possible - a line whose first
    non-space content begins a Tira command - so that any refinement of the
    collector shows up here as a disagreement rather than as silence.
    """
    with open(document, encoding='utf-8') as handle:
        text = handle.read()
    lines = re.findall(
        r'^[ \t]*(?:d2\s+|dashboard\s+)?(tira\.[a-z][a-z0-9._-]*(?:[ \t]+--?[^\n]*|[ \t]*#[^\n]*)?)$',
        text, re.M)
    # Normalised the way examples() normalises, or the two sides describe the
    # same line differently and every comparison is noise.
    return {re.sub(r'^dashboard\s+', '', line.strip()) for line in lines}


def examples():
    """Every example, split into the ones that can be run and the ones that cannot.

    Both are returned. Reporting only the first was how this check came to
    print a number that read as coverage: sixty of a hundred and ninety lines
    were dropped by the placeholder rule and never appeared anywhere, so the
    documentation looked checked when a third of it had not been tried. The
    header above records the same fault being found once before, for quoted
    values, and fixed without the silence being fixed with it.
    """
    found = []
    set_aside = []
    for document in DOCUMENTS:
        if not os.path.exists(document):
            continue
        with open(document, encoding='utf-8') as handle:
            text = handle.read()
        for pattern in (BACKTICKED, FENCED):
            for match in pattern.finditer(text):
                line = match.group(1).strip()
                line = re.sub(r'^dashboard\s+', '', line)
                if CONTINUED.search(line):
                    set_aside.append((document, line))
                    continue
                bare = REFERENCE.sub( '', QUOTED.sub( '', line ) )
                if PLACEHOLDER.search(bare):
                    set_aside.append((document, line))
                    continue
                found.append((document, line))
    return found, set_aside


def main():
    # Removed however this ends. This runs from the push gate, so a scratch
    # board left behind is not one directory - it is one per release, and a
    # failing gate would leave more litter than a passing one.
    # A killed process runs no finally, and the gate does get interrupted - a
    # timeout during one run of this is what left the board that was found in
    # /tmp after the cleanup was supposedly fixed. Turning the signal into an
    # exception means even that path tidies up.
    for interruption in (signal.SIGTERM, signal.SIGINT):
        signal.signal(interruption, lambda *_: sys.exit(130))

    scratch = tempfile.mkdtemp(prefix='tira-doc-examples-')
    try:
        return check(scratch)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
        remove_police_store(os.path.join(scratch, 'board'))



def remove_police_store(project):
    """Remove the enforcement store the scratch board caused to exist.

    The board is in a temp directory and goes with it. Its police store is not:
    police keeps its state outside the board it watches, deliberately, so that it
    can never become a second writer to it - and that state lives in
    ~/.tira-police under a slug derived from the board's path. Removing the board
    removes nothing of it.

    Sixty-four of them had accumulated here between 12 and 15 August, one per
    gate run, each holding the rule suspension the policies guide's own example
    writes. They outlive the boards they describe by definition, and the
    directory they sit in is where a person looks when police is behaving oddly -
    it is where two stores for one board were found on 14 August, by reading a
    listing. At one per release that listing stops being readable.

    Only this run's store, derived the same way lib/Tira/CLI.pm derives it. Every
    other entry belongs to a real board.
    """
    home = os.environ.get('HOME') or tempfile.gettempdir()
    slug = re.sub(r'[^A-Za-z0-9]+', '-', project).strip('-')
    if not slug:
        return
    shutil.rmtree(os.path.join(home, '.tira-police', slug), ignore_errors=True)

# The repository's own entrypoints, not the installed skill.
#
# This ran every example through `d2`, which runs whatever was installed last -
# so the check asked whether the documentation matched some earlier release and
# never whether it matched the code about to be pushed. Backwards in both
# directions: documentation for a command this commit deletes kept passing,
# because the installed copy still had it, and documentation for a command this
# commit adds was refused, because the installed copy had never heard of it.
# That is not a hypothetical - it refused the release that added tira.backup,
# and the only way through would have been to ship the command undocumented,
# which the other half of this gate forbids.
#
# tools/browser-tests was written to use the repository's entrypoints for
# exactly this reason. This is the same resolution: a dotted command is
# cli/<verb>, or skills/<parts>/cli/<verb> when it has a type.
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def entrypoint(dotted):
    """The script in this working tree that a dotted command runs.

    Mirroring the dispatcher rather than approximating it. It derives the
    dotted name from the path by dropping every 'skills' directory, so
    tira.project.people.activate is skills/project/skills/people/cli/activate
    and tira.backup is cli/backup. Guessing one level of nesting found three
    families of command that do exist and reported them missing.
    """
    verb = dotted[len('tira.'):] if dotted.startswith('tira.') else dotted
    parts = verb.split('.')
    action = parts[-1]
    areas = parts[:-1]
    if not areas:
        candidate = os.path.join(ROOT, 'cli', action)
        return candidate if os.path.isfile(candidate) else None
    nested = os.path.join(ROOT, 'skills', *[part for area in areas
                                            for part in (area, 'skills')][:-1],
                          'cli', action)
    return nested if os.path.isfile(nested) else None


def invoke(dotted, *arguments):
    """Run a documented command against this working tree."""
    script = entrypoint(dotted)
    if script is None:
        return None
    return ['perl', '-I' + os.path.join(ROOT, 'lib'), script] + list(arguments)


def check(scratch):
    project = os.path.join(scratch, 'board')
    setup = subprocess.run(
        invoke('tira.project.new', '--name', 'Examples', '--dir', project,
               '--members', 'michael', '--columns', 'backlog, implement, done',
               '--sow-prefix', 'DXS', '--epic-prefix', 'DXE', '--ticket-prefix', 'TKT',
               '-o', 'json'),
        capture_output=True, text=True)
    if setup.returncode != 0:
        raise SystemExit(f'docs-examples-run: could not make a scratch board: {setup.stderr.strip()}')

    # The guide documents card-sandbox-missing, which refuses to be declared
    # where no repository can be resolved. The scratch board is given one, which
    # is exactly what a real board declaring that rule has to do - TKT-178.
    repository = os.path.join(scratch, 'repository')
    os.makedirs(os.path.join(repository, '.git'), exist_ok=True)
    subprocess.run(invoke('tira.project.update', '--project', project,
                          '--repo', repository, '-o', 'json'),
                   capture_output=True, text=True)

    # A card and a question to quote, so an example naming TKT-001 is about the
    # documentation rather than about an empty board.
    subprocess.run(invoke('tira.ticket.create', '--project', project,
                          '--title', 'A card', '-o', 'json'),
                   capture_output=True, text=True)

    ran = 0
    problems = []
    runnable, skipped = examples()
    for document, line in runnable:
        try:
            # comments=True so a trailing "# set it" is a note to the reader
            # rather than an argument. shlex knows a hash inside quotes is not
            # a comment; a regex over the line would not.
            argv = shlex.split(line, comments=True)
        except ValueError:
            problems.append((document, line, 'this is not a command line anybody could type'))
            continue
        if not argv:
            continue
        if argv[0].startswith(FOREVER) or 'browser' in line:
            continue
        command = invoke(argv[0], '--project', project, *argv[1:])
        if command is None:
            problems.append((document, line,
                             f'this working tree ships no entrypoint for {argv[0]}'))
            continue
        try:
            # Run from the scratch board, never from the repository root.
            #
            # Not every command takes --project. `tira.project.create` is
            # documented as creating a project in the current directory, and
            # that is exactly what it does with a --project it has no use for -
            # so running the examples from here created a .tira at the root of
            # this repository, which is where this project's own live delivery
            # board sits. That board is not in git, and it was destroyed once
            # already, on 2026-08-11, by tests running against the directory it
            # lives in.
            #
            # It never did damage because the board was already there and the
            # command refused. A guard whose only protection is that the
            # accident has not lined up yet is not a guard.
            done = subprocess.run(command, capture_output=True, text=True,
                                  stdin=subprocess.DEVNULL, timeout=30,
                                  cwd=scratch)
        except subprocess.TimeoutExpired:
            problems.append((document, line, 'this example never returned'))
            continue
        ran += 1
        output = (done.stdout or '') + (done.stderr or '')

        if argv[0] in RECITERS:
            # It recited something. Whether it worked is the exit status, and a
            # document that mentions an error is a document doing its job.
            if done.returncode != 0:
                problems.append((document, line,
                                 (output.strip().splitlines() or ['it printed nothing'])[0]))
            continue

        for fatal in FATAL:
            if fatal in output:
                problems.append((document, line, output.strip().splitlines()[0]))
                break

    for document, line, why in problems:
        print(f'{document}: {line}\n    {why}')

    if problems:
        print(f'\n{len(problems)} documented example(s) of {ran} are not what the command accepts.')
        return 1

    # Named, not just counted, when asked. A third of the documentation going
    # untried is worth knowing about; which third is what makes it actionable -
    # a real value mistaken for a shape, like a prefix that happens to be
    # capitals, is only visible by name.
    if os.environ.get('TIRA_EXAMPLES_SHOW_SKIPPED'):
        for document, line in skipped:
            print(f'set aside  {document}: {line}')

    # Every example line accounted for, so a gap cannot hide in the difference.
    #
    # Until 1.97 this printed two numbers that did not have to add up to
    # anything: an example the patterns missed was in neither, so "254 run and
    # understood" was true about what was found and silent about what was not.
    # Nineteen were in that gap. Collecting the lines independently and
    # insisting every one of them was either run or set aside turns the next such gap into a
    # failure rather than a silence.
    accounted = {line for _, line in runnable} | {line for _, line in skipped}
    present = set()
    for document in DOCUMENTS:
        if os.path.exists(document):
            present |= collect(document)
    unaccounted = sorted(present - accounted)
    if unaccounted:
        print(f'docs-examples-run: {len(unaccounted)} example(s) are in the '
              'documents and were collected by nothing - not run, not set aside, '
              'and in neither number:')
        for line in unaccounted:
            print(f'    {line}')
        return 1

    print(f'docs-examples-run: {ran} documented examples run and understood, '
          f'{len(skipped)} set aside for carrying a shape a reader must replace '
          f'(TIRA_EXAMPLES_SHOW_SKIPPED=1 names them)')
    return 0


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env bash
#
# Break the pre-push gate on purpose, one check at a time, and confirm each one
# refuses.
#
# A check that has never been seen to fail is not a check, it is a hope. Five
# times in one session a guard on this project turned out to be passing for
# free: a hash that never landed in the file it was meant to be read from, a
# mutation that never applied, a test driving commands that do not exist. Every
# one of them was green.
#
# So the gate is proved the way the code is: by breaking it. This runs the real
# hook, from the real repository, with one thing wrong at a time.
#
# The suite is not run here. `docker` is replaced on PATH by a script that
# prints whatever this file tells it to, so the gate's judgement about a suite
# result can be tested in a second rather than in ten minutes. The real suite
# still runs, for real, on every actual push - what is proved here is that the
# gate reaches the right verdict about what it is told, which is the part that
# has silently been wrong before.
#
# Usage: tools/prove-the-gate

set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

hook="$root/tools/hooks/pre-push"
[ -x "$hook" ] || { echo "prove-the-gate: $hook is missing"; exit 1; }

# One at a time. This moves real files aside and puts a real card on the real
# board, so two running at once corrupt each other - which is exactly what
# happened: one run hid a tool the other was looking for, and each reported the
# gate broken when the only broken thing was running it twice. The same lesson
# as never running two test containers at once, made mechanical.
lock="$root/.prove-the-gate.lock"
exec 9>"$lock"
flock -n 9 || {
    echo "prove-the-gate: another run is in progress. This moves files aside and puts a card on the board, so two at once would corrupt each other."
    exit 1
}

sandbox="$(mktemp -d)"

# The probe card is discarded on the way out however this ends. An interrupted
# run used to leave a hollow card on the real board, and every later run then
# failed at the card check for a reason that had nothing to do with what it was
# testing - a check that leaves the thing it checks in a worse state.
hollow=""
hidden_from=""
hidden_to=""

# Why this card is on the board, written before it is set aside. A discarded
# card with no reason is indistinguishable from abandoned work - twenty of them
# accumulated here, one per release, and the discard-unexplained rule reported
# every one of them for ever. A tool that makes work for the rules it is
# checking is not a check, it is a source of noise.
say_why() {
    # A comment needs a person the board knows. This tool ships, and a board
    # with no "claude" on it is an ordinary board - so the author is whoever
    # this board actually has, falling back to its first member. Getting this
    # wrong would leave the card silent and then fail the very push that was
    # trying to be tidy.
    who="$(d2 tira.project.show -o json | python3 -c '
import json, sys
people = [p["id"] for p in json.load(sys.stdin).get("people", []) if p.get("active", True)]
print("claude" if "claude" in people else (people[0] if people else ""))' 2>/dev/null)"
    [ -n "$who" ] || return 0
    d2 tira.comment.add --ref "$1" --author "$who" -o json \
        --text 'Raised by tools/prove-the-gate to prove the push gate refuses a card with nothing on it, then set aside. Not abandoned work - this card existed for the length of one gate run, and its being refused is the check passing.' \
        >/dev/null 2>&1 || true
}

cleanup() {
    # A tool moved aside is put back however this ends. An interrupted run used
    # to leave a shipped file missing from the working tree, which is the third
    # time this file has damaged the thing it was checking - and the worst of
    # the three, because the next run then reports a check broken that is not.
    [ -n "$hidden_to" ] && [ -f "$hidden_to" ] && mv "$hidden_to" "$hidden_from"
    [ -n "$hollow" ] && say_why "$hollow" \
        && d2 tira.ticket.discard --ref "$hollow" -o json >/dev/null 2>&1
    rm -rf "$sandbox"
    rm -f "$lock"
}
trap cleanup EXIT INT TERM

# And it will not start against a board that is already wrong, because then
# every check before the card probe fails for that reason instead of its own.
if ! ./tools/card-holes >/dev/null 2>&1; then
    echo "prove-the-gate: the board has an incomplete card, so every check here would fail for that reason:"
    ./tools/card-holes
    exit 1
fi

passed=0
failed=0

# A run of the hook with PATH rigged and, optionally, one tool taken away.
# Returns the hook's exit status; its output lands in $out.
out=""
run_hook() {
    local suite_output="$1" missing="${2:-}"
    local bin="$sandbox/bin"
    rm -rf "$bin"
    mkdir -p "$bin"

    printf '#!/usr/bin/env bash\ncat <<%s\n%s\n%s\n' 'SUITE_EOF' "$suite_output" 'SUITE_EOF' >"$bin/docker"
    chmod +x "$bin/docker"

    if [ -n "$missing" ]; then
        hidden_from="$root/$missing"
        hidden_to="$sandbox/hidden-$(basename "$missing")"
        mv "$hidden_from" "$hidden_to"
    fi

    out="$(PATH="$bin:$PATH" "$hook" 2>&1)"
    local status=$?

    if [ -n "$missing" ]; then
        mv "$hidden_to" "$hidden_from"
        hidden_from=""
        hidden_to=""
    fi
    return $status
}

# The gate must refuse, and it must say why in words that name the problem.
refuses() {
    local what="$1" expect="$2"
    shift 2
    if "$@"; then
        printf 'NOT PROVED - the gate allowed a push with %s\n' "$what"
        failed=$(( failed + 1 ))
        return
    fi
    if ! printf '%s' "$out" | grep -qiE "$expect"; then
        printf 'NOT PROVED - it refused %s, but never said so: %s\n' "$what" "$(printf '%s' "$out" | tail -2)"
        failed=$(( failed + 1 ))
        return
    fi
    printf 'proved - %s is refused\n' "$what"
    passed=$(( passed + 1 ))
}

PASSING_SUITE='Result: PASS
lib/Tira.pm               100.0  100.0  100.0
lib/Tira/CLI.pm           100.0  100.0  100.0
lib/Tira/DashboardWeb.pm  100.0  100.0  100.0'

# --- a missing tool is a failure, not a skip ------------------------------
#
# The failure mode that matters most: a gate that disappears when somebody
# deletes a file looks exactly like a gate that passed.
#
# tools/browser-tests is here because the gate grew a step and this tool did
# not. The browser step was proved to refuse three ways by hand when it was
# added, and that proof lived only in a card - nothing re-ran it, so somebody
# could have made the step skip quietly and the gate would still have called
# itself proved. Hiding the runner exercises the guard without opening a
# browser, which keeps this tool as cheap as its other checks.
for tool in tools/board-backup tools/card-holes tools/docs-match-code tools/docs-examples-run tools/browser-tests; do
    refuses "a missing $(basename "$tool")" 'missing|refusing' run_hook "$PASSING_SUITE" "$tool"
done

# --- a failing suite ------------------------------------------------------
refuses 'a failing suite' 'suite failed' run_hook 'Result: FAIL
t/01-cli.t (Wstat: 512 Tests: 3 Failed: 1)'

# --- a suite that did not run at all --------------------------------------
#
# Silence read as success on this project the same morning this was written:
# a dependency install printed nothing because it had timed out.
refuses 'a suite that produced nothing' 'suite failed|did not run' run_hook ''

# --- coverage below the line ----------------------------------------------
refuses 'coverage below 100%' 'coverage is below' run_hook 'Result: PASS
lib/Tira.pm               100.0  100.0  100.0
lib/Tira/CLI.pm            99.9  100.0   99.9
lib/Tira/DashboardWeb.pm  100.0  100.0  100.0'

# --- a module that was never measured -------------------------------------
#
# The quiet one. A module dropped from the -select list is not reported at all,
# and an absent line reads like a passing line to anything that only greps for
# numbers below a hundred.
refuses 'a module with no coverage measured at all' 'no coverage was measured' run_hook 'Result: PASS
lib/Tira.pm               100.0  100.0  100.0
lib/Tira/CLI.pm           100.0  100.0  100.0'

# --- the board is checked -------------------------------------------------
#
# Not a stub: a real hollow card is put on the real board, the gate is run, and
# the card is discarded again. Anything less proves the tool runs, not that the
# gate refuses.
hollow="$(d2 tira.ticket.create --title 'Probe: a hollow card the gate must refuse' -o json |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["ref"])')"
if [ -n "$hollow" ]; then
    refuses "a hollow card on the board ($hollow)" 'fill the cards in' run_hook "$PASSING_SUITE"
    say_why "$hollow"
    d2 tira.ticket.discard --ref "$hollow" -o json >/dev/null
    hollow=""
else
    printf 'NOT PROVED - could not raise a probe card\n'
    failed=$(( failed + 1 ))
fi

# --- the documentation is checked -----------------------------------------
#
# An entrypoint that ships undocumented is exactly what happened in 1.05, when
# twenty-one of them went out with not one named in the documents an agent
# reads.
probe="$root/skills/police/cli/undocumented-probe"
cp "$root/skills/police/cli/suspend" "$probe" 2>/dev/null || cp "$root/cli/police" "$probe"
chmod +x "$probe"
refuses 'an entrypoint nobody documented' 'documentation and the code disagree' run_hook "$PASSING_SUITE"
rm -f "$probe"

# --- the examples are run rather than read --------------------------------
#
# His requirement, and the one that found an example the validator refuses.
# A real example is broken on purpose here, in the real document, and put back.
# Staged in a clone, not in the real document. The first version of this
# appended a broken example to SKILLS.md and put it back afterwards - and when
# a run was interrupted the putting back never happened, so the broken example
# sat in the shipped documentation and was committed with everything else. A
# check that can damage what it is checking is worse than no check, and this
# is the second time this file has taught me that.
example_probe() {
    local clone="$sandbox/clone-example"
    rm -rf "$clone"
    git clone --quiet --no-hardlinks "$root" "$clone" 2>/dev/null || {
        printf 'NOT PROVED - could not clone the repository to stage a broken example\n'
        failed=$(( failed + 1 ))
        return
    }
    cp "$root/tools/docs-examples-run" "$clone/tools/docs-examples-run"
    printf '\n`dashboard tira.project.create --name "Probe" --a-flag-that-does-not-exist`\n' >>"$clone/SKILLS.md"

    local bin="$sandbox/bin"
    rm -rf "$bin"
    mkdir -p "$bin"
    printf '#!/usr/bin/env bash\ncat <<%s\n%s\n%s\n' 'SUITE_EOF' "$PASSING_SUITE" 'SUITE_EOF' >"$bin/docker"
    chmod +x "$bin/docker"

    out="$(cd "$clone" && PATH="$bin:$PATH" ./tools/docs-examples-run 2>&1)"
    local status=$?
    rm -rf "$clone"

    if [ "$status" -eq 0 ]; then
        printf 'NOT PROVED - a documented example the command refuses was accepted\n'
        failed=$(( failed + 1 ))
    elif ! printf '%s' "$out" | grep -qiE 'not what the command accepts'; then
        printf 'NOT PROVED - it refused the example without saying why: %s\n' "$(printf '%s' "$out" | tail -2)"
        failed=$(( failed + 1 ))
    else
        printf 'proved - a documented example the command refuses is refused\n'
        passed=$(( passed + 1 ))
    fi
}
example_probe

# --- and it passes when everything is right -------------------------------
#
# A gate that refuses everything is not a gate either. This is the control.
if run_hook "$PASSING_SUITE"; then
    printf 'proved - a clean tree is allowed through\n'
    passed=$(( passed + 1 ))
else
    printf 'NOT PROVED - the gate refused a clean tree: %s\n' "$(printf '%s' "$out" | tail -3)"
    failed=$(( failed + 1 ))
fi

# --- a release nobody would receive ---------------------------------------
#
# An install compares versions: same version, no update. A push that changes
# shipped code without changing VERSION is in the repository and on nobody's
# machine, which is how a board spent a night being driven by a version four
# releases behind the working tree.
#
# Staged in a throwaway clone rather than in this repository. The first version
# of this probe committed to the real one and undid it afterwards, and when the
# run was interrupted halfway the undoing never happened - a check that can
# damage what it is checking is worse than no check.
version_probe() {
    local what="$1" shipped_file="$2" expect="$3"
    local clone="$sandbox/clone-$what"
    git clone --quiet --no-hardlinks "$root" "$clone" 2>/dev/null || {
        printf 'NOT PROVED - could not clone the repository to stage %s\n' "$what"
        failed=$(( failed + 1 ))
        return
    }

    # The clone's origin is this repository, so origin/<branch> is exactly what
    # the gate compares against.
    # A clone carries committed history, and the gate being proved may not be
    # committed yet - the first version of this probe tested the old hook and
    # reported that the new rule did not work. The tools under test are copied
    # in as they are now.
    cp "$root/tools/hooks/pre-push" "$clone/tools/hooks/pre-push"
    cp "$root/tools/docs-examples-run" "$clone/tools/docs-examples-run"

    ( cd "$clone" && printf '\n# probe\n' >>"$shipped_file" &&
      git commit --quiet --no-verify -m "probe: $what" -- "$shipped_file" ) || return

    local bin="$sandbox/bin"
    rm -rf "$bin"
    mkdir -p "$bin"
    printf '#!/usr/bin/env bash\ncat <<%s\n%s\n%s\n' 'SUITE_EOF' "$PASSING_SUITE" 'SUITE_EOF' >"$bin/docker"
    chmod +x "$bin/docker"

    out="$(cd "$clone" && PATH="$bin:$PATH" ./tools/hooks/pre-push 2>&1)"
    local status=$?

    if [ "$expect" = 'refused' ]; then
        if [ "$status" -eq 0 ]; then
            printf 'NOT PROVED - the gate allowed %s\n' "$what"
            failed=$(( failed + 1 ))
        elif ! printf '%s' "$out" | grep -qiE 'VERSION did not|reach nobody'; then
            printf 'NOT PROVED - it refused %s without saying why: %s\n' "$what" "$(printf '%s' "$out" | tail -2)"
            failed=$(( failed + 1 ))
        else
            printf 'proved - %s is refused\n' "$what"
            passed=$(( passed + 1 ))
        fi
    else
        # A clone has no board, so the later steps of the gate cannot run there
        # and their refusal says nothing about this rule. What is proved is
        # that the version step let it past, which is the whole claim.
        if printf '%s' "$out" | grep -qiE 'VERSION did not|reach nobody'; then
            printf 'NOT PROVED - the version check refused %s\n' "$what"
            failed=$(( failed + 1 ))
        else
            printf 'proved - %s is allowed through\n' "$what"
            passed=$(( passed + 1 ))
        fi
    fi
    rm -rf "$clone"
}

version_probe 'a shipped change with no version bump' 'lib/Tira.pm' refused
version_probe 'a change no install copies' 't/00-foundation.t' allowed

# --- the commit gate reads the subject, not the whole message --------------
#
# It took every card reference anywhere in a message as a card the commit was
# against, and this project quotes references in commit messages constantly -
# that is how a commit explains what it found. A message describing a defect
# that mentioned a finished card was refused for working on it, and the way
# through was to take the evidence out of the message.
#
# Run for real, against the real board, because a hook that is only read is the
# thing this whole tool exists to stop.

commit_hook="$root/tools/hooks/commit-msg"
[ -x "$commit_hook" ] || { echo "prove-the-gate: tools/hooks/commit-msg is missing"; exit 1; }

run_commit_hook() {
    local message="$1"
    local file="$sandbox/commit-message"
    printf '%s\n' "$message" >"$file"
    out="$("$commit_hook" "$file" 2>&1)"
    return $?
}

# A card that is certainly finished, and one that is certainly being worked.
finished="$(d2 tira.ticket.list -o json 2>/dev/null |
    python3 -c 'import json,sys
rows = json.load(sys.stdin)
rows = rows if isinstance(rows, list) else rows.get("tickets") or rows.get("records") or []
print(next((r["ref"] for r in rows if r.get("column") == "done"), ""))' 2>/dev/null)"
working="$(d2 tira.ticket.list -o json 2>/dev/null |
    python3 -c 'import json,sys
rows = json.load(sys.stdin)
rows = rows if isinstance(rows, list) else rows.get("tickets") or rows.get("records") or []
print(next((r["ref"] for r in rows if r.get("column") not in ("done", "discard", "backlog")), ""))' 2>/dev/null)"

if [ -n "$finished" ] && [ -n "$working" ]; then
    refuses "a commit against a finished card ($finished)" "in 'done'" \
        run_commit_hook "$finished the work is over"

    refuses 'a commit naming no card at all' 'name the card' \
        run_commit_hook 'something happened'

    refuses "a card named only in the body ($working)" 'name the card' \
        run_commit_hook "no card up here

        the body mentions $working, which is prose"

    if run_commit_hook "$working doing the work

Quoting $finished as evidence, the way every commit here explains what it
found."; then
        printf 'proved - a finished card quoted as evidence is allowed through\n'
        passed=$(( passed + 1 ))
    else
        printf 'NOT PROVED - the commit gate refused a quoted reference: %s\n' "$(printf '%s' "$out" | tail -2)"
        failed=$(( failed + 1 ))
    fi
else
    printf 'NOT PROVED - could not find a finished and a working card to drive the commit gate\n'
    failed=$(( failed + 1 ))
fi

# --- and it leaves nothing behind -----------------------------------------
#
# The example check makes a scratch board to run against. It runs on every
# push, so one left behind is not one directory but one per release - twelve of
# them accumulated in a single night before anybody looked.
litter="$(ls -d /tmp/tira-doc-examples-* 2>/dev/null | wc -l)"
if [ "$litter" -eq 0 ]; then
    printf 'proved - the gate leaves no scratch boards behind\n'
    passed=$(( passed + 1 ))
else
    printf 'NOT PROVED - %s scratch board(s) left in /tmp after running the gate\n' "$litter"
    failed=$(( failed + 1 ))
fi

printf '\n%d proved, %d not proved\n' "$passed" "$failed"
[ "$failed" -eq 0 ]

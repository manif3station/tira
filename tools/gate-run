#!/usr/bin/env bash
#
# Run the suite and coverage against a checkout of HEAD, and record a pass
# against the tree that produced it.
#
# Until 4.62 the push hook ran this same step itself, and this tool existed so
# it would not have to run it twice. TKT-680 removed the suite from the hook
# entirely, so nothing consults the record automatically any more - the record
# is for a person asking whether the tree HEAD carries has already been proved.
# This is now the ONLY place the suite is run against a commit rather than
# against whatever is lying in the working directory.
#
# Built for TKT-351, measured on one release: the gate ran the suite and
# passed - 258 files, 6072 tests, 100.0 on all three modules - and the push
# hook then ran the identical suite against the identical tree, because only
# one test container may run at a time and the hook had no way to know this
# tree was already proved. Six cards and five releases queued behind it from
# 19:44 past midnight, and three attempts were killed at a ceiling that had to
# be raised before any could finish - every one of them a second run of
# something already proved.
#
# The hook was not wrong to distrust a claim - "I ran it and it passed" is a
# sentence, and a gate that accepts sentences is not a gate. What can be
# trusted instead is a record naming the exact tree it tested, in git's own
# hash. That property is why the record is still worth writing even now that
# no gate reads it: it cannot be produced for a tree nobody had. See
# tools/gate-cache-write and tools/gate-cache-read for the record itself.
#
# Requires a clean tree - commit first. This tests the commit that is about
# to be pushed; testing anything else would record a pass for a tree nobody is
# pushing, which is the exact gap "I ran it and it passed" already had.
#
# Usage: tools/gate-run

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

if [ -n "$(git status --porcelain)" ]; then
    echo "gate-run: uncommitted changes present - commit first. This records a result against HEAD's tree; an uncommitted change is not part of it, and testing the desk instead of the commit is a mistake nothing else catches now - since 4.62 the push hook runs no suite at all, so this is the only place a committed tree is proved rather than whatever happens to be lying in the working directory." >&2
    exit 1
fi

workspace="$(cd "$root/../.." && pwd)"
compose="$workspace/docker-compose.testing.yml"
[ -f "$compose" ] || { echo "gate-run: cannot find $compose" >&2; exit 1; }

tree_hash="$(git rev-parse HEAD^{tree})"
echo "gate-run: testing a checkout of HEAD ($tree_hash), the commit about to be pushed - not the working directory"

tree="$(mktemp -d)"
output="$(mktemp)"
cleanup() {
    rm -f "$output"
    git worktree remove --force "$tree" >/dev/null 2>&1 || true
}
trap cleanup EXIT

git worktree add --detach --quiet "$tree" HEAD \
  || { echo "gate-run: could not check out HEAD" >&2; exit 1; }

SUITE_TIMEOUT=3600
docker compose -f "$compose" run --rm -v "$tree:/workspace/skills/tira" perl-test bash -lc '
  cd /workspace/skills/tira &&
  rm -rf cover_db .test-tmp &&
  cpanm --quiet --notest --installdeps . >/dev/null 2>&1 &&
  timeout --signal=KILL '"$SUITE_TIMEOUT"' env HARNESS_PERL_SWITCHES=-MDevel::Cover prove -lr t 2>&1 | tail -4 &&
  select_args=() &&
  while IFS= read -r m; do select_args+=(-select "$m"); done \
    < <(find lib -name "*.pm" | sort) &&
  if [ ${#select_args[@]} -eq 0 ]; then
    echo "gate-run: no modules found under lib/ - refusing to report coverage over nothing" >&2
    exit 1
  fi &&
  cover -ignore_covered_err -report text "${select_args[@]}" \
    -coverage statement -coverage subroutine 2>/dev/null | grep -E "^lib|^Total"
  rm -rf cover_db
' >"$output" 2>&1 || { echo "gate-run: the suite did not run:" >&2; tail -3 "$output" >&2; exit 1; }

cat "$output"

if ! grep -q '^Result: PASS' "$output"; then
    echo "gate-run: the suite did not pass - no record written" >&2
    exit 1
fi

# Modules the gate deliberately does not hold to 100%. Empty, and it should
# stay that way unless somebody has a reason to write on the line beside the
# path - which is the whole point of the list existing rather than a module
# simply being missing from a loop. TKT-594.
EXEMPT_COVERAGE=(
)

# Derived from the worktree that was actually tested, not from the working
# directory. The clean-tree check above means the two agree today, but that is a
# guarantee living forty lines away from the thing relying on it - and a gate
# that measures one set of modules and enforces against another would be this
# card's own fault wearing a different hat.
modules=()
while IFS= read -r m; do modules+=("${m#"$tree"/}"); done \
  < <(find "$tree/lib" -name '*.pm' | sort)

# An empty derivation must refuse. Deriving the list fixed a gate that checked
# three modules of four; a gate that checks NONE and exits zero would be the
# same fault taken to its end, and the loop below would simply not run.
if [ ${#modules[@]} -eq 0 ]; then
    echo "gate-run: no modules found under lib/ - refusing rather than passing a gate that checked nothing" >&2
    exit 1
fi

checked=""
for module in "${modules[@]}"; do
    exempt=""
    for entry in "${EXEMPT_COVERAGE[@]}"; do
        case "$entry" in
            # A path with something after it: the reason, which is the whole
            # point of the list. Matched with a space so the reason cannot be
            # omitted.
            "$module "*) exempt="$entry" ;;
            # A bare path with no reason REFUSES rather than exempting. An
            # exemption nobody justified is the silence this card removed from
            # the module list; honouring it here would put it back one line
            # further in.
            "$module")
                echo "gate-run: $module is listed as exempt with no reason beside it - write one, or remove the entry" >&2
                exit 1
                ;;
        esac
    done
    if [ -n "$exempt" ]; then
        echo "gate-run: $module is exempt from the coverage gate - $exempt"
        continue
    fi
    checked="$checked $module"
    line="$(grep -F "$module" "$output" | grep -E '[0-9]+\.[0-9]' || true)"
    if [ -z "$line" ]; then
        echo "gate-run: no coverage was measured for $module - no record written" >&2
        exit 1
    fi
    if ! echo "$line" | grep -qE '100\.0[[:space:]]+100\.0[[:space:]]+100\.0'; then
        echo "gate-run: coverage is below 100% for $module - no record written: $line" >&2
        exit 1
    fi
done

# Say what was held to the standard, so the guarantee can be read rather than
# assumed. A gate that checks a subset in silence is what TKT-594 was raised
# about: lib/Tira/OnboardWeb.pm had no coverage requirement for four releases
# and nothing said so, because the loop only visited the modules it named.
echo "gate-run: checked coverage for${checked:- nothing - lib/ held no modules}"

"$root/tools/gate-cache-write" "$output"

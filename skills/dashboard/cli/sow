#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename qw(dirname);
use File::Spec;
use FindBin;

my $cursor = $FindBin::Bin;
while ( !-f File::Spec->catfile( $cursor, 'lib', 'Tira', 'CLI.pm' ) ) {
    my $parent = dirname($cursor);
    die "Cannot locate Tira skill root\n" if $parent eq $cursor;
    $cursor = $parent;
}
$cursor =~ /\A([^\x00-\x1f\x7f]+)\z/ or die "Unsafe Tira skill root\n";
my $root = $1;
unshift @INC, File::Spec->catdir( $root, 'lib' );
require Tira::CLI;

exit Tira::CLI->run( command => 'dashboard.sow', argv => \@ARGV );

__END__

=head1 NAME

tira.dashboard.sow - Render the sow Kanban dashboard

=head1 DESCRIPTION

Dispatches the type-specific Tira dashboard, including self-contained table
output, through the shared CLI.

=cut


#!/usr/bin/env python3
"""Check the documentation against what the code actually does, both ways.

Exit 0 when they agree, 1 when they do not.

Michael asked for this as a standing gate rather than a task, running last
before every push. The reason it has to run last: documentation edited after a
gate has shipped a broken build on this project twice, and a check that runs
before the edits proves nothing about what actually goes out.

Both directions, because either alone hides the other. A command with no
documentation is invisible - twenty-one shipped that way in 1.05 while every
documentation guard passed, because each verified that what was WRITTEN was
correct and none checked that what EXISTS was written. Documentation for a
command that does not exist is the same lie told the other way round.
"""

import os
import re
import subprocess
import sys

DOCUMENTS = ('SKILLS.md', 'docs/commands.md', 'docs/POLICIES.md')

# The three record boards share one set of verbs and are documented once, and
# the dashboard's per-board forms are the same command with a type attached.
FAMILIES = (re.compile(r'^tira\.(sow|epic|ticket)\.'), re.compile(r'^tira\.dashboard\.'))


def shipped():
    """Every command an agent can actually run, named the way they type it."""
    found = set()
    for base in ('cli', 'skills'):
        for directory, _, files in os.walk(base):
            for name in files:
                path = os.path.join(directory, name)
                if not os.access(path, os.X_OK) or os.path.isdir(path):
                    continue
                # Mirror the dispatcher exactly rather than approximately.
                # cli/<verb> is tira.<verb>. skills/<parts>/cli/<verb> is
                # tira.<parts>.<verb>, with 'skills' dropped from the parts -
                # but never from the verb, or the command literally called
                # 'skills' disappears and is then reported as documented but
                # missing, which is what an earlier version of this did.
                if path.startswith('cli/'):
                    found.add('tira.' + os.path.basename(path))
                    continue
                middle = path[len('skills/'):].rsplit('/cli/', 1)
                if len(middle) != 2:
                    continue
                parts = [p for p in middle[0].split('/') if p != 'skills']
                found.add('.'.join(['tira'] + parts + [middle[1]]))
    return found


def documented_text():
    text = ''
    for document in DOCUMENTS:
        if not os.path.exists(document):
            raise SystemExit(f'docs-match-code: {document} is missing')
        with open(document, encoding='utf-8') as handle:
            text += handle.read()
    return text


def in_a_family(command):
    return any(pattern.match(command) for pattern in FAMILIES)


def check_everything_shipped_is_written(text, commands, problems):
    for command in sorted(commands):
        if in_a_family(command):
            continue
        if command not in text:
            problems.append(f'{command} ships and is named in no document')


def check_everything_written_exists(text, commands, problems):
    """The other direction: documentation promising a command that is not there.

    Only names written as commands count - `tira.foo.bar` in a code fence or
    after `dashboard`/`d2` - so ordinary prose mentioning a family name is not
    mistaken for a promise.
    """
    promised = set(re.findall(r'(?:dashboard|d2)\s+(tira\.[a-z0-9.-]+)', text))
    for command in sorted(promised):
        command = command.rstrip('.,')
        if in_a_family(command):
            base = re.sub(r'^(tira\.(?:sow|epic|ticket|dashboard))\..*', r'\1', command)
            if any(c.startswith(base) for c in commands):
                continue
        if command not in commands:
            problems.append(f'{command} is documented and does not exist')


def check_documented_flags_are_accepted(text, problems):
    """A flag documented against a command the command does not take.

    Checked by asking the command itself rather than by reading the source, so
    this stays true when the source moves.
    """
    for command, flag in re.findall(r'(?:dashboard|d2)\s+(tira\.[a-z0-9.-]+)((?:\s+--[a-z-]+)*)', text):
        for one in re.findall(r'--([a-z-]+)', flag):
            if one in ('help',):
                continue
            probe = subprocess.run(
                ['perl', '-Ilib', '-MTira::CLI', '-e',
                 'exit Tira::CLI->run( command => $ARGV[0], argv => [ "--$ARGV[1]", "x", "--help" ] )',
                 command.replace('tira.', ''), one],
                capture_output=True, text=True)
            if 'Unknown option' in probe.stderr or 'Invalid command-line options' in probe.stdout:
                problems.append(f'{command} is documented with --{one}, which it does not accept')


def main():
    problems = []
    text = documented_text()
    commands = shipped()

    check_everything_shipped_is_written(text, commands, problems)
    check_everything_written_exists(text, commands, problems)
    check_documented_flags_are_accepted(text, problems)

    if problems:
        print('docs-match-code: the documentation and the code disagree\n')
        for problem in problems:
            print(f'  {problem}')
        print('\nDocumentation that describes something else is worse than none: '
              'it is trusted, and it is wrong.')
        return 1

    print(f'docs-match-code: {len(commands)} commands, and the documents agree with all of them')
    return 0


if __name__ == '__main__':
    sys.exit(main())

#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename qw(dirname);
use File::Spec;
use FindBin;

my $cursor = $FindBin::Bin;
while ( !-f File::Spec->catfile( $cursor, 'lib', 'Tira', 'CLI.pm' ) ) {
    my $parent = dirname($cursor);
    die "Cannot locate Tira skill root\n" if $parent eq $cursor;
    $cursor = $parent;
}
$cursor =~ /\A([^\x00-\x1f\x7f]+)\z/ or die "Unsafe Tira skill root\n";
my $root = $1;
unshift @INC, File::Spec->catdir( $root, 'lib' );
require Tira::CLI;

exit Tira::CLI->run( command => 'dev.found.bug_or_improvement', argv => \@ARGV );

__END__

=head1 NAME

tira.dev.found.bug_or_improvement - Report a fault or an improvement in Tira

=head1 DESCRIPTION

Locates the Tira skill root and delegates to C<Tira::CLI>, which resets the
raises the report on Tira's own board. The caller gives what it found and the
project it is reporting from, and nothing about where the report goes.

=cut

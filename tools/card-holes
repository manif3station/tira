#!/usr/bin/env python3
"""Report cards on this project's Tira board that are missing required fields.

Exit 0 when every live card is complete, 1 when any is not.

Michael found a card on 2026-08-11 with a title, a description and nothing
else - no problem statement, no scope, no deliverables, no test steps, no BDD,
no checklist - moving between columns as though it were real work. His words:
"just a zombie card moving around". He asked, fairly, whether he was going to
have to check every card himself from now on.

He is not. This is the check, and it runs from the pre-push hook, so a push
with a hollow card fails the same way a push with a failing test fails.
Reading is done through Tira's own commands rather than the files, so it stays
correct if the on-disk layout changes.
"""

import json
import os
import subprocess
import time
import sys

# Columns in the order work passes through them. A card whose checklist is
# finished must have left the columns that mean "still being done".
#
# Asked of the board rather than carried here. This was a list of the seven
# columns the tool happened to know, and every column-dependent check began by
# locating the card in it - so a column the list had never heard of was not in
# it, the check did not apply, and the card passed. Silently, which is the only
# way it could have survived: a board that declares a working column lost the
# gate, evidence and fix-version checks for everything in it, and the push
# still succeeded. The engine had already learned this and asks the board.
# TKT-223.
#
# discard stays out of the flow, deliberately. A discarded card is not work in
# progress, and asking it for a gate would be the tool arguing with a decision
# somebody already made. It is identified by what the board says about it - a
# protected column that is not the one work starts in - rather than by its name,
# so a board that calls it something else is still understood.
def flow_from_board():
    columns = tira('tira.column.list', '--type', 'ticket', '-o', 'json')
    roles = tira('tira.column.roles', '-o', 'json').get('ticket', {})
    starts_in = roles.get('backlog')
    names = [c['name'] for c in columns
             if not (c.get('protected') and c.get('name') != starts_in)]
    return names, roles



# The milestones, by what the board says they mean rather than by name. A board
# that calls its testing column something else is still understood; one that has
# no such column is told so, because guessing which of its columns means proven
# would be inventing a rule nobody declared.
def milestone(role, fallback):
    named = ROLES.get(role)
    if named in FLOW:
        return FLOW.index(named)
    if fallback in FLOW:
        return FLOW.index(fallback)
    raise SystemExit(
        f'card-holes: this board has no {role} column and no {fallback} column, '
        'so there is no point past which a card is claiming to be proven. '
        'Declare one, or these checks cannot say anything.')



REQUIRED = [
    'problem_or_feature',
    'solution_needed',
    'key_details',
    'deliverables',
    'acceptance_criteria',
    'test_steps',
    'bdd',
    'atdd',
    'checklist',
]


ATTEMPTS = 3
INSTALLING = 'not found in skill'


def tira(*args):
    """Ask the board, surviving the moment the skill is being written.

    The gate failed twice reporting a command that ships as unknown -
    tira.epic.show once, tira.ticket.list the next push - and both entrypoints
    ran fine seconds later. The installed skill directory had been rewritten
    inside the failing gate's window: the dispatcher resolves a command by
    finding its entrypoint, and during an install the entrypoint is briefly
    absent.

    Only that failure is waited on, and only for a moment. Anything else stops
    the gate at once, because an audit that retried everything would go quiet
    exactly when the board is broken - and if it never resolves, the gate says
    how many times it tried rather than reporting the last attempt as though it
    were the only one.
    """
    caller = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'tira-call')
    done = subprocess.run([caller, *args], capture_output=True, text=True)
    if done.returncode != 0:
        raise SystemExit(f'card-holes: {" ".join(args)} failed: {done.stderr.strip()}')
    return json.loads(done.stdout)


# The board is asked once, here, because everything below is derived from it.
# These sat above the caller they use, so the tool died with a NameError before
# reading a single card - and it died inside a push, because the hook runs this
# file from the working tree rather than from the copy it is about to push.
# TKT-223.
FLOW, ROLES = flow_from_board()

SETTLED_FROM = milestone('testing', 'verify')

PROVEN_FROM = SETTLED_FROM

# Shipping has no role on the board, so the column is named here and the
# terminal column stands in for a board that does not have it - a card in the
# column work ends in is shipped by anybody's definition.
SHIPPED_FROM = (FLOW.index('push') if 'push' in FLOW
                else milestone('done', 'done'))


def premature(record):
    """A card in a finished column with work still unticked.

    Found on 2026-08-11 when TKT-008 was moved to done with "restore proven
    from the backup" still pending, and this check said nothing - it only
    looked for the opposite mistake. A board that catches you moving too late
    but not too early is only half a check, and the half it misses is the one
    that overstates progress.
    """
    checklist = record.get('checklist') or []
    if not checklist:
        return None
    column = record.get('column')
    if column not in ('done', 'push'):
        return None
    waiting = [c for c in checklist if c.get('status') != 'done']
    if not waiting:
        return None
    return (f"is in {column} with {len(waiting)} checklist item(s) unfinished: "
            + '; '.join(c.get('item', '?') for c in waiting[:3]))


def stalled(record):
    """A card whose checklist is done but whose column says otherwise.

    Michael caught this on 2026-08-11: every item on TKT-005 was ticked and
    the card was still sitting in implement. Ticking a box is recording the
    work; moving the card is what the board actually shows him. When those two
    disagree, the board is lying, and he is the one who notices.
    """
    checklist = record.get('checklist') or []
    if not checklist:
        return None
    if any(item.get('status') != 'done' for item in checklist):
        return None
    column = record.get('column')
    if column not in FLOW:
        return None
    if FLOW.index(column) >= SETTLED_FROM:
        return None
    return f'every checklist item is done but the card is still in {column}'


# Past this point a card is making a claim about work that happened, and a
# claim with nothing attached is a sentence. Michael, watching the work log:
# "you have not updated everything on the card, just the checklist - I know you
# are lazy about it." He is right that it needs to be mechanical rather than
# remembered.


def unproven(record):
    """A card claiming to be verified with nothing anybody could check."""
    column = record.get('column')
    if column not in FLOW or FLOW.index(column) < PROVEN_FROM:
        return None

    # Not applied backwards. Thirty-five cards shipped before this check
    # existed, and demanding artefacts nobody kept would block every push for
    # ever and teach everybody to switch the check off. Anything reaching done
    # from now on passes through verify, document and push, where this bites.
    if column == 'done':
        return None

    said = []
    if not record.get('gate_passing_log'):
        said.append('no gate has been recorded')
    if not record.get('evidence'):
        said.append('no evidence is attached')
    if FLOW.index(column) >= SHIPPED_FROM and not record.get('fix_version'):
        said.append('no fix version')
    if not said:
        return None
    return (f"is in {column} with " + ' and '.join(said)
            + ' - a claim about work that happened, with nothing anybody could check')


def holes(record, kind):
    missing = [f for f in REQUIRED if not record.get(f)]

    scope = record.get('scope') or {}
    if not scope.get('included'):
        missing.append('scope_in')
    if not scope.get('excluded'):
        missing.append('scope_out')

    if not record.get('priority'):
        missing.append('priority')

    # A statement of work sits at the top of the tree, so it has no parent to
    # be missing. Everything below one does - unless it says it stands alone.
    #
    # Michael asked for an investigation raised on its own, with no parent,
    # because what it finds decides where it belongs; filing it under an epic
    # first would be deciding that before understanding it. A card with no
    # parent by accident is still a hole, so the difference is declared: the
    # 'standalone' label says somebody meant it.
    labels = [str(l).lower() for l in (record.get('labels') or [])]
    if kind != 'sow' and not record.get('parent') and 'standalone' not in labels:
        missing.append('parent')

    return missing


def parents_ahead():
    """Parents claiming to be finished above children that are not.

    Michael photographed an epic in done with a ticket in backlog underneath
    it, an hour after he had asked for that ticket, and a statement of work in
    done above both epics. Every other check here looks at a card on its own,
    so nothing was ever going to see it - and it is the direction that
    overstates progress, which is the direction he cannot check without opening
    every parent himself.
    """
    everything = []
    for kind in ('sow', 'epic', 'ticket'):
        everything += [dict(row, kind=kind) for row in tira(f'tira.{kind}.list', '-o', 'json')]

    live = {}
    for row in everything:
        if row.get('column') not in ('done', 'discard'):
            live[row['ref']] = row

    problems = []
    for row in everything:
        if row.get('column') != 'done':
            continue
        record = tira(f"tira.{row['kind']}.show", '--ref', row['ref'], '-o', 'json')
        open_children = sorted(
            child['ref'] for child in live.values()
            if (child.get('parent') or '') == row['ref'])

        # A card that lists children it does not carry a parent link from is
        # the same thing seen from the other side, so both are read.
        listed = (record.get('linkage') or {}).get('sub_ticket_refs') or []
        open_children = sorted(set(open_children) | {r for r in listed if r in live})

        if open_children:
            problems.append(
                f"{row['ref']} says it is finished while "
                f"{', '.join(open_children)} "
                f"{'are' if len(open_children) > 1 else 'is'} still open")
    return problems


def main():
    failures = 0
    for kind in ('sow', 'epic', 'ticket'):
        for row in tira(f'tira.{kind}.list', '-o', 'json'):
            # Discarded work is set aside, not planned. Holding it to the same
            # standard would only teach people to ignore this check - but it
            # still has to say why it was set aside. Twenty probe cards from
            # this very gate accumulated in discard with nothing on them,
            # indistinguishable from work somebody gave up on, and the police
            # rule reported all twenty on every run for ever.
            if row.get('column') == 'discard':
                record = tira(f'tira.{kind}.show', '--ref', row['ref'], '-o', 'json')
                if not record.get('comments'):
                    failures += 1
                    print(f"{row['ref']} was discarded with no reason given")
                continue
            record = tira(f'tira.{kind}.show', '--ref', row['ref'], '-o', 'json')
            missing = holes(record, kind)
            if missing:
                failures += 1
                print(f"{row['ref']} ({row['column']}) is missing: {', '.join(missing)}")
            behind = stalled(record)
            if behind:
                failures += 1
                print(f"{row['ref']}: {behind}")
            early = premature(record)
            if early:
                failures += 1
                print(f"{row['ref']} {early}")
            thin = unproven(record)
            if thin:
                failures += 1
                print(f"{row['ref']} {thin}")

    for ahead in parents_ahead():
        failures += 1
        print(ahead)

    if failures:
        print(f'\n{failures} card(s) incomplete. Fill them in before pushing.')
        print('A card that cannot say what problem it solves, what is in scope, '
              'or how it will be proved is not a ticket - it is a title.')
        print('A card whose checklist is finished while its column says otherwise '
              'is a board that reports the wrong thing to whoever is reading it.')
        print('A card in done with work still unticked is the same lie told the '
              'other way round, and it is the one that overstates progress.')
        print('A parent in done above a child that is not is that same lie one '
              'level up, and nobody sees it without opening every parent.')
        print('A card past verify with no gate and no evidence is a claim about '
              'work that happened with nothing anybody could check.')
        print('A discarded card with no reason on it is indistinguishable from '
              'work somebody abandoned, and it stays that way for ever.')
        return 1

    print('every live card is complete')
    return 0


if __name__ == '__main__':
    sys.exit(main())

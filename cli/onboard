#!/usr/bin/env perl
use strict;
use warnings;
use File::Spec;
use FindBin;
unshift @INC, File::Spec->catdir( $FindBin::Bin, '..', 'lib' );
require Tira::CLI;
exit Tira::CLI->run( command => 'onboard', argv => \@ARGV );
__END__
=head1 NAME
Tira onboard - Guided setup for a new project
=head1 DESCRIPTION
Asks for the project name, its directory, its people, each board's reference
prefix, and the columns, then creates everything after showing a summary and
confirming. Declining creates nothing.
=cut

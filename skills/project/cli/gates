#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename qw(basename dirname);
use File::Spec;
use FindBin;

my $cursor = $FindBin::Bin;
while ( !-f File::Spec->catfile( $cursor, 'lib', 'Tira', 'CLI.pm' ) ) {
    my $parent = dirname($cursor);
    die "Cannot locate Tira skill root\n" if $parent eq $cursor;
    $cursor = $parent;
}
$cursor =~ /\A([^\x00-\x1f\x7f]+)\z/ or die "Unsafe Tira skill root\n";
my $root = $1;
unshift @INC, File::Spec->catdir( $root, 'lib' );
require Tira::CLI;

my ( $command, $type );
if ( File::Spec->canonpath($FindBin::Bin) eq File::Spec->catdir( $root, 'cli' ) ) {
    $command = basename($0);
}
else {
    my $relative = File::Spec->abs2rel( $FindBin::Bin, File::Spec->catdir( $root, 'skills' ) );
    my @parts = File::Spec->splitdir($relative);
    pop @parts if @parts && $parts[-1] eq 'cli';
    @parts = grep { $_ ne 'skills' } @parts;
    my $action = basename($0);
    if ( @parts == 1 && $parts[0] =~ /\A(?:sow|epic|ticket)\z/ ) {
        $type = $parts[0];
        $command = "record.$action";
    }
    else {
        $command = join '.', @parts, $action;
    }
}

exit Tira::CLI->run( command => $command, type => $type, argv => \@ARGV );

__END__

=head1 NAME

Tira command dispatcher - Resolve a dotted Developer Dashboard command

=head1 DESCRIPTION

Locates the Tira repository root, derives the dotted command from the installed
entrypoint path, and delegates argument handling to C<Tira::CLI>.

Reads or declares the project's gate vocabulary, the one list C<gate.add>'s
C<--gate> and every record's C<--sdlc-gate> are both validated against once
it exists. C<--gate-name> is repeatable and declaring it replaces whatever
vocabulary was declared before, the same way C<column.roles --role entry=X>
replaces its own declared list. With no C<--gate-name> given, reads it back.
A project that has never declared one takes free text on both, exactly as
before this command existed.

=cut

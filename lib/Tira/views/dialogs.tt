<dialog class="card-dialog"><header><button class="card-dialog__back" type="button" aria-label="Back" hidden>&larr;</button><div><span class="card-dialog__ref">Card</span><h2 class="card-dialog__title">Details</h2></div><button class="card-dialog__close" type="button" aria-label="Close" autofocus>&times;</button></header><p class="card-dialog__error" hidden></p><div class="card-viewer" hidden><header><button class="card-viewer__prev" type="button" aria-label="Previous attachment">&larr;</button><span class="card-viewer__name"></span><button class="card-viewer__next" type="button" aria-label="Next attachment">&rarr;</button><a class="card-viewer__download" target="_blank">Download</a><button class="card-viewer__close" type="button" aria-label="Close viewer">&times;</button></header><img hidden alt="attachment preview"><iframe hidden title="attachment preview"></iframe><pre class="card-viewer__text" hidden></pre><video class="card-viewer__video" hidden controls playsinline></video><audio class="card-viewer__audio" hidden controls></audio><div class="card-viewer__fallback" hidden><p>Preview is not supported for this file in this browser.</p><p>Use the Download button above to open it locally.</p></div></div><div class="card-dialog__sections"></div></dialog><dialog class="column-dialog"><header><h2>Columns</h2><button class="column-dialog__close" type="button" aria-label="Close" autofocus>&times;</button></header><p class="column-dialog__error" hidden></p><ol class="column-editor"></ol><div class="column-dialog__add"><input class="column-dialog__new" type="text" placeholder="New column name" aria-label="New column name"><button type="button" class="column-dialog__addbtn">Add column</button></div><footer><button type="button" class="column-dialog__cancel">Cancel</button><button type="button" class="column-dialog__save">Save</button></footer></dialog><dialog class="proof-dialog"><header><h2>Proof</h2><button class="proof-dialog__close" type="button" aria-label="Close" autofocus>&times;</button></header><div class="proof-dialog__body"></div></dialog><dialog class="policy-dialog"><header><h2>Policies</h2><button class="policy-dialog__close" type="button" aria-label="Close" autofocus>&times;</button></header><p class="policy-dialog__error" hidden></p><div class="policy-dialog__tabs"><button type="button" class="policy-dialog__tab is-active" data-policy-tab="declared">Declared</button><button type="button" class="policy-dialog__tab" data-policy-tab="declined">Declined</button><button type="button" class="policy-dialog__tab" data-policy-tab="undeclared">Undeclared</button></div><ul class="policy-declared" data-policy-pane="declared"></ul><ul class="policy-declined" data-policy-pane="declined" hidden></ul><ul class="policy-undeclared" data-policy-pane="undeclared" hidden></ul><form class="policy-form"><h3>Declare / edit a policy</h3><div class="policy-form__row"><label>Rule</label><select class="policy-form__rule"></select></div><div class="policy-form__row"><label>Action</label><select class="policy-form__action"></select></div>
[%- FOREACH field IN fields -%]
<div class="policy-form__row" data-field="[% field %]"><label><span class="policy-form__label-text">[% field %]</span>[%- IF field == 'message' %] <button type="button" class="policy-form__token-hint" data-token-hint aria-label="Which {token}s can I use here?">?</button>[% END -%]</label><input type="text" class="policy-form__[% field %]"></div>
[%- END -%]
<div class="policy-form__token-popover" data-token-popover hidden></div><div class="policy-form__row" data-field="type"><label>Scope: type</label><select class="policy-form__type"><option value="">(whole project)</option><option value="sow">sow</option><option value="epic">epic</option><option value="ticket">ticket</option></select></div><div class="policy-form__row" data-field="on_column"><label>Scope: on column</label><input type="text" class="policy-form__on_column"></div><div class="policy-form__row" data-field="ref"><label>Scope: ref</label><input type="text" class="policy-form__ref"></div><div class="policy-form__row" data-field="reason"><label>Decline reason</label><input type="text" class="policy-form__reason"></div><footer><button type="button" class="policy-form__clear">New</button><button type="button" class="policy-form__remove" hidden>Remove</button><button type="button" class="policy-form__decline">Decline</button><button type="button" class="policy-form__declare">Declare</button></footer></form></dialog>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in — [% name %]</title><style>[% style %]</style><div class="card"><h1>[% name %]</h1><p class="sub">Sign in to use this board.</p><p class="msg" id="m"></p><form id="f" autocomplete="on"><label for="id_">Name</label><input id="id_" name="id_" autocomplete="username" autocapitalize="off" spellcheck="false" required><label for="pw">Password</label><input id="pw" name="pw" type="password" autocomplete="current-password" required><button id="go" type="submit">Sign in</button></form><p class="note">First time here? Whatever you type becomes your password.</p></div><script>[% script %]</script>
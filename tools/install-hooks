#!/usr/bin/env bash
#
# Install this repository's gates into .git/hooks.
#
# The hooks themselves are tracked under tools/hooks so they survive a fresh
# clone and can be reviewed like any other code. .git/hooks is not tracked by
# git, so a gate that lives only there is a gate that vanishes the moment
# somebody clones the repository - which is not a gate, it is a local habit
# with a shell script around it.

set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

hooks_dir="$(git rev-parse --git-path hooks)"
mkdir -p "$hooks_dir"

for hook in tools/hooks/*; do
  name="$(basename "$hook")"
  target="$hooks_dir/$name"

  # A relative symlink, so the installed hook is always the tracked file and
  # the two cannot drift apart.
  ln -sf "$(realpath --relative-to="$hooks_dir" "$hook")" "$target"
  echo "installed $name -> $hook"
done

# The gate takes twenty minutes, and git opens the connection to the remote
# before it runs the hook. GitHub closes an SSH session that sits idle that
# long, so the gate would pass, print that everything was fine, and then git
# would die of SIGPIPE writing to a connection that had gone - reporting
# success for a release that never left the machine. Measured, with GIT_TRACE:
# "Connection to github.com closed by remote host" arrives while the hook is
# still checking the board.
#
# Keepalives hold the session open for as long as the gate takes. Set here
# rather than in anybody's global ssh config, because it belongs to this
# repository's gate and to nothing else on the machine.
git config core.sshCommand 'ssh -o ServerAliveInterval=45 -o ServerAliveCountMax=120'
echo 'configured ssh keepalives so a long gate does not outlive the connection'

echo
echo 'Gates now in force:'
echo '  commit-msg  every commit names a live card that is at a working gate'
echo '  pre-push    board backup, card audit, full suite, 100% coverage'

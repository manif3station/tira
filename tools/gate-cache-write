#!/usr/bin/env bash
#
# Record a gate result against the tree that produced it, keyed by git's own
# tree hash - the hash git computes from the actual blob contents HEAD
# carries, not a checksum this tool invents. That is what makes the record
# worth trusting at all: producing a matching record means producing the tree
# it claims to have tested, which is the same thing as actually testing it.
# The push hook used to consult it before running the suite; since 4.62 it
# runs no suite, so nothing reads this automatically and the record answers a
# person's question instead. See tools/gate-cache-read for how it is read, and
# TKT-351 for why either exists.
#
# Usage: tools/gate-cache-write <output-file>
#
# The caller decides whether the result is worth recording - this tool writes
# whatever it is handed, unconditionally. tools/gate-run only calls it after
# confirming a real pass at 100% coverage on all three modules.

set -euo pipefail

output_file="${1:?usage: tools/gate-cache-write <output-file>}"
[ -f "$output_file" ] || { echo "gate-cache-write: $output_file does not exist" >&2; exit 1; }

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

tree_hash="$(git rev-parse HEAD^{tree})"
common_git="$(git rev-parse --git-common-dir)"
cache_dir="$common_git/tira-gate-cache"
mkdir -p "$cache_dir"

# Written to a temp file and moved into place, so a reader can never see a
# half-written record - the same reason atomic writes exist everywhere else
# in this project.
tmp="$(mktemp "$cache_dir/.tmp.XXXXXX")"
{
    printf 'tree=%s\n' "$tree_hash"
    printf 'at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cat "$output_file"
} >"$tmp"
mv -f "$tmp" "$cache_dir/$tree_hash"

echo "gate-cache-write: recorded for $tree_hash"
